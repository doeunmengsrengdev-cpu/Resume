{
      "$schema": "https://openapi.vercel.sh/vercel.json",
      "buildCommand": "npm run build",
      "outputDirectory": ".",
      "cleanUrls": true,
      "rewrites": [
        { "source": "/Index.html", "destination": "/index.html" },
        { "source": "/Index", "destination": "/index.html" },
        { "source": "/index", "destination": "/index.html" },
        { "source": "/", "destination": "/index.html" }
      ]
    }
